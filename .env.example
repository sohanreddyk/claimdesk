# Copy to .env and fill in LLM_API_KEY. Never commit .env.

# --- LLM ---
# Provider: anthropic | openai. The model names must belong to the provider you choose.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Stronger model for rendering replies; fast model for per-turn extraction.
LLM_MODEL=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
#
# To use OpenAI instead, change these three lines (and put an OpenAI key in LLM_API_KEY):
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-5.4-mini
#   LLM_MODEL_FAST=gpt-5.4-mini
# Optional, OpenAI reasoning models only: a lower value answers faster (for example low).
# LLM_REASONING_EFFORT=

# --- Data ---
FIXTURES_DIR=apps/insurance_claims/fixtures

# --- Evaluator demo profile ---
# Fixed "today" so appeal deadlines in the sample data are live.
# Remove this line to use the real system date.
AS_OF_DATE=2026-03-05
# Workflow inspector + scenario buttons. Evaluator/development only;
# defaults to false in code. Never enable in a customer-facing deployment.
ENABLE_DEBUG_INSPECTOR=true
# Representative-approval simulation: default | timeout
CONSENT_SCENARIO=default

# --- SOP thresholds (optional overrides; defaults live in code) ---
# MIN_FACTORS=3
# MAX_MISMATCHES=3
# MAX_VERIFICATION_REFUSALS=2
# MAX_OOS_STRIKES=2
# MAX_FRUSTRATION_STREAK=3
# MAX_CONSENT_POLLS=5
# MAX_CASE_LOOPS=3
# MAX_EMAIL_ADDRESS_ATTEMPTS=2
